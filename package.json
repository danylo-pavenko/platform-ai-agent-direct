{
  "name": "platform-ai-agent-direct",
  "version": "1.7.75",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/admin",
    "apps/super-admin",
    "apps/platform-worker"
  ],
  "scripts": {
    "dev": "bash infra/scripts/dev.sh",
    "dev:all": "bash infra/scripts/dev.sh --all",
    "dev:backend": "npm run dev -w apps/backend",
    "build:backend": "npm run build -w apps/backend",
    "dev:admin": "npm run dev -w apps/admin",
    "build:admin": "npm run build -w apps/admin",
    "db:seed": "cd apps/backend && npx tsx src/prisma/seed.ts",
    "db:migrate": "cd apps/backend && npx prisma migrate dev",
    "db:studio": "cd apps/backend && npx prisma studio",
    "bootstrap:knowledge": "cd apps/backend && npx tsx src/scripts/bootstrap-tenant-knowledge.ts",
    "test:backend": "npm run test -w apps/backend",
    "test:admin": "npm run test -w apps/admin",
    "test:super-admin": "npm run test -w apps/super-admin"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=11.21.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "dependencies": {
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "esbuild@0.27.7": true,
    "@parcel/watcher@2.5.6": true
  }
}
